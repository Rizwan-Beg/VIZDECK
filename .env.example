# Optional external VIZDECK AI Room Analysis service (FastAPI).
# If omitted or offline locally, Next.js falls back cleanly to ai-service/cli_analyze.py.
VISUALIZER_API_URL=http://127.0.0.1:8000

# Optional headless e-commerce catalog API endpoint.
NEXT_PUBLIC_CATALOG_API_URL=

# Required before commercial launch: the inbox that receives Contact page enquiries.
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
